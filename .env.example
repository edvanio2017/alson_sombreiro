# =============================================================================
# Alson Sombreiro · Variáveis de ambiente
# Copie este ficheiro para `.env` na raiz do monorepo: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Base de dados (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=alson
POSTGRES_PASSWORD=alson_dev_password
POSTGRES_DB=alson_sombreiro
POSTGRES_PORT=5432

# String de ligação usada pelo Prisma.
# Em execução local (fora do Docker) usar `localhost`; dentro do Docker usar `postgres`.
DATABASE_URL=postgresql://alson:alson_dev_password@localhost:5432/alson_sombreiro?schema=public

# -----------------------------------------------------------------------------
# API (NestJS)
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3333
# Prefixo global das rotas REST
API_PREFIX=api
# Origens autorizadas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# -----------------------------------------------------------------------------
# Autenticação (JWT + refresh token)
# -----------------------------------------------------------------------------
# ATENÇÃO: gerar segredos fortes em produção -> openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-em-producao
JWT_REFRESH_TTL=7d
# Custo do hash bcrypt
BCRYPT_ROUNDS=10

# -----------------------------------------------------------------------------
# Uploads / anexos
# -----------------------------------------------------------------------------
# Driver de armazenamento: `local` (disco), abstraído pela porta StorageService
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
# Tamanho máximo por ficheiro em bytes (10 MB)
UPLOAD_MAX_FILE_SIZE=10485760
# Nº máximo de ficheiros por submissão
UPLOAD_MAX_FILES=10
# Mime types aceites globalmente (a validação por campo é definida no backoffice)
UPLOAD_ALLOWED_MIME=application/pdf,image/png,image/jpeg,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# -----------------------------------------------------------------------------
# E-mail (SMTP). Em desenvolvimento usa-se o Mailpit do docker-compose.
# Interface web do Mailpit: http://localhost:8025
# -----------------------------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Alson Sombreiro Consultadoria
MAIL_FROM_ADDRESS=nao-responder@alsonsombreiro.ao
# Destinatário interno das notificações de novos pedidos
MAIL_INTERNAL_RECIPIENT=geral@alsonsombreiro.ao

# -----------------------------------------------------------------------------
# Rate limiting / anti-spam do formulário público
# -----------------------------------------------------------------------------
# Janela em segundos e nº máximo de pedidos por janela (global)
THROTTLE_TTL=60
THROTTLE_LIMIT=60
# Limites específicos da submissão pública de pedidos e do formulário de contacto
PUBLIC_SUBMIT_TTL=3600
PUBLIC_SUBMIT_LIMIT=5
# Tentativas de início de sessão
LOGIN_THROTTLE_TTL=60
LOGIN_THROTTLE_LIMIT=10
# Renovação de sessão
REFRESH_THROTTLE_TTL=60
REFRESH_THROTTLE_LIMIT=30
# Consulta pública do estado de um pedido
TRACK_THROTTLE_TTL=60
TRACK_THROTTLE_LIMIT=20
# Honeypot: nome do campo oculto que deve chegar sempre vazio
ANTISPAM_HONEYPOT_FIELD=website
# Tempo mínimo (ms) entre carregar e submeter o formulário. Abaixo disto é bot
ANTISPAM_MIN_FILL_TIME_MS=3000

# -----------------------------------------------------------------------------
# Frontends (Nuxt)
# -----------------------------------------------------------------------------
# URL pública da API consumida pelo browser
NUXT_PUBLIC_API_BASE=http://localhost:3333/api
# URL da API para pedidos SSR (dentro do Docker: http://api:3333/api)
NUXT_API_BASE_SERVER=http://localhost:3333/api
# URL canónica do site público (sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=Alson Sombreiro Consultadoria
WEB_PORT=3000
ADMIN_PORT=3001
