# =============================================================================
# Produção — variáveis do servidor. Copiar para /opt/alson/.env e preencher.
# NUNCA versionar o ficheiro .env real (só este exemplo).
# =============================================================================

# --- Imagens (GHCR) ----------------------------------------------------------
IMAGE_PREFIX=ghcr.io/edvanio2017/alson_sombreiro
IMAGE_TAG=latest

# --- Base de dados -----------------------------------------------------------
POSTGRES_USER=alson
POSTGRES_PASSWORD=TROCAR_por_segredo_forte
POSTGRES_DB=alson_sombreiro

# --- API ---------------------------------------------------------------------
API_PREFIX=api
# Origens autorizadas para CORS (frontends):
CORS_ORIGINS=https://alsonsombreiro.ao,https://www.alsonsombreiro.ao,https://admin.alsonsombreiro.ao
JWT_ACCESS_SECRET=TROCAR_openssl_rand_base64_48
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=TROCAR_openssl_rand_base64_48
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=10

# --- E-mail (SMTP real de produção) -----------------------------------------
MAIL_HOST=smtp.exemplo.ao
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Alson Sombreiro Consultadoria
MAIL_FROM_ADDRESS=nao-responder@alsonsombreiro.ao
MAIL_INTERNAL_RECIPIENT=geral@alsonsombreiro.ao

# --- URLs públicos -----------------------------------------------------------
SITE_URL=https://alsonsombreiro.ao
ADMIN_URL=https://admin.alsonsombreiro.ao
SITE_NAME=Alson Sombreiro Consultadoria
# API vista pelo browser:
PUBLIC_API_BASE=https://api.alsonsombreiro.ao/api

# --- Rate limiting -----------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=60
PUBLIC_SUBMIT_TTL=3600
PUBLIC_SUBMIT_LIMIT=5
