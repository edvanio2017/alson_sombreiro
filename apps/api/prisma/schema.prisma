// =============================================================================
// Alson Sombreiro Consultadoria: modelo de dados
// PostgreSQL + Prisma
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enumerados
// -----------------------------------------------------------------------------

enum RoleName {
  ADMIN
  GESTOR
  AGENTE
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  EMAIL
  PHONE
  SELECT
  MULTISELECT
  CHECKBOX
  FILE
}

enum Priority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum HistoryEvent {
  CRIADO
  ESTADO_ALTERADO
  RESPONSAVEL_ALTERADO
  PRIORIDADE_ALTERADA
  NOTA_ADICIONADA
  ANEXO_ADICIONADO
  ANEXO_REMOVIDO
  DADOS_ALTERADOS
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// -----------------------------------------------------------------------------
// Identidade e acessos
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  label       String
  description String?
  /// Permissões granulares no formato `recurso:acção`, ex.: `services:write`.
  permissions String[] @default([])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  roleId       String    @map("role_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// Remoção lógica: preserva a integridade do histórico e da auditoria.
  deletedAt    DateTime? @map("deleted_at")

  role             Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshTokens    RefreshToken[]
  assignedRequests Request[]        @relation("RequestAssignee")
  notes            Note[]
  historyEntries   RequestHistory[]
  auditLogs        AuditLog[]
  uploadedFiles    Attachment[]

  @@index([roleId])
  @@index([active, deletedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Guarda-se apenas o hash SHA-256 do token, nunca o token em claro.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ipAddress String?   @map("ip_address")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// Catálogo de serviços e construtor de formulários
// -----------------------------------------------------------------------------

model Service {
  id               String   @id @default(uuid()) @db.Uuid
  slug             String   @unique
  name             String
  shortDescription String   @map("short_description")
  description      String   @db.Text
  /// Lista de benefícios apresentada na página de detalhe.
  benefits         String[] @default([])
  icon             String?
  coverImage       String?  @map("cover_image")
  metaTitle        String?  @map("meta_title")
  metaDescription  String?  @map("meta_description")
  ogImage          String?  @map("og_image")
  featured         Boolean  @default(false)
  order            Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  fields   FormField[]
  requests Request[]

  @@index([active, order])
  @@index([featured])
  @@map("services")
}

/// Definição de um campo do formulário de um serviço.
/// É esta tabela que torna os formulários configuráveis sem alterar código.
model FormField {
  id          String    @id @default(uuid()) @db.Uuid
  serviceId   String    @map("service_id") @db.Uuid
  /// Chave técnica usada como nome do campo no payload, ex.: `numero_bi`.
  key         String
  label       String
  type        FieldType
  placeholder String?
  helpText    String?   @map("help_text")
  required    Boolean   @default(false)
  order       Int       @default(0)
  /// Largura no grid: 1 = meia coluna, 2 = coluna inteira.
  width       Int       @default(2)
  /// Opções de SELECT/MULTISELECT: `[{ "label": "...", "value": "..." }]`.
  options     Json      @default("[]")
  /// Regras de validação (min, max, pattern, extensões aceites, ...).
  validation  Json      @default("{}")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  service Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  values  RequestField[]

  @@unique([serviceId, key])
  @@index([serviceId, order])
  @@map("form_fields")
}

// -----------------------------------------------------------------------------
// Pipeline configurável
// -----------------------------------------------------------------------------

model RequestStatus {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  name            String
  /// Cor hexadecimal usada no Kanban e nos badges.
  color           String   @default("#64748B")
  order           Int      @default(0)
  isInitial       Boolean  @default(false) @map("is_initial")
  isFinal         Boolean  @default(false) @map("is_final")
  /// Se verdadeiro, a entrada neste estado envia e-mail ao requerente.
  notifyRequester Boolean  @default(false) @map("notify_requester")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requests Request[]

  @@index([active, order])
  @@map("request_statuses")
}

// -----------------------------------------------------------------------------
// Pedidos
// -----------------------------------------------------------------------------

model Request {
  id             String    @id @default(uuid()) @db.Uuid
  /// Número de referência apresentado ao requerente: `AS-2026-000123`.
  reference      String    @unique
  serviceId      String    @map("service_id") @db.Uuid
  statusId       String    @map("status_id") @db.Uuid
  assigneeId     String?   @map("assignee_id") @db.Uuid
  priority       Priority  @default(NORMAL)
  requesterName  String    @map("requester_name")
  requesterEmail String    @map("requester_email")
  requesterPhone String?   @map("requester_phone")
  /// Metadados de origem, úteis para auditoria e anti-spam.
  sourceIp       String?   @map("source_ip")
  sourceAgent    String?   @map("source_agent")
  /// Momento em que o pedido entrou num estado final.
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  status      RequestStatus    @relation(fields: [statusId], references: [id], onDelete: Restrict)
  assignee    User?            @relation("RequestAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  values      RequestField[]
  attachments Attachment[]
  history     RequestHistory[]
  notes       Note[]

  @@index([statusId, createdAt])
  @@index([serviceId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([requesterEmail])
  @@map("requests")
}

/// Valor submetido para um campo do formulário.
/// `fieldKey`, `label` e `type` são desnormalizados de propósito: o pedido
/// mantém-se legível mesmo que o campo seja renomeado ou removido do serviço.
model RequestField {
  id           String    @id @default(uuid()) @db.Uuid
  requestId    String    @map("request_id") @db.Uuid
  fieldId      String?   @map("field_id") @db.Uuid
  fieldKey     String    @map("field_key")
  label        String
  type         FieldType
  /// Valor normalizado (string, número, booleano ou lista).
  value        Json?
  /// Representação legível usada em listagens, exportações e e-mails.
  displayValue String    @default("") @map("display_value")
  order        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")

  request Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  field   FormField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@unique([requestId, fieldKey])
  @@index([requestId])
  @@map("request_fields")
}

model Attachment {
  id           String    @id @default(uuid()) @db.Uuid
  requestId    String    @map("request_id") @db.Uuid
  /// Campo do formulário que originou o anexo (nulo se adicionado no backoffice).
  fieldKey     String?   @map("field_key")
  originalName String    @map("original_name")
  storedName   String    @map("stored_name")
  path         String
  mimeType     String    @map("mime_type")
  size         Int
  checksum     String?
  uploadedById String?   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  request    Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([requestId, deletedAt])
  @@map("attachments")
}

/// Timeline do pedido: quem alterou o quê e quando.
model RequestHistory {
  id          String       @id @default(uuid()) @db.Uuid
  requestId   String       @map("request_id") @db.Uuid
  event       HistoryEvent
  description String
  fromValue   String?      @map("from_value")
  toValue     String?      @map("to_value")
  /// Autor da alteração; nulo quando a origem é o formulário público.
  authorId    String?      @map("author_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("request_history")
}

model Note {
  id        String    @id @default(uuid()) @db.Uuid
  requestId String    @map("request_id") @db.Uuid
  authorId  String?   @map("author_id") @db.Uuid
  body      String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("notes")
}

// -----------------------------------------------------------------------------
// Auditoria e suporte
// -----------------------------------------------------------------------------

/// Registo transversal de alterações em entidades sensíveis.
model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  entity    String
  entityId  String      @map("entity_id")
  action    AuditAction
  /// `{ "campo": { "from": ..., "to": ... } }`
  changes   Json?
  actorId   String?     @map("actor_id") @db.Uuid
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Contador atómico usado para gerar números de referência sequenciais por ano.
model ReferenceCounter {
  year      Int      @id
  sequence  Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reference_counters")
}
